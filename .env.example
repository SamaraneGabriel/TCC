# LLM provider: "gemini" | "openai" | "ollama"
LLM_PROVIDER=gemini

# Gemini (google-generativeai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Opcional: preencher GCP_PROJECT faz os providers Gemini usarem Vertex AI (billing no
# projeto GCP, autenticacao via `gcloud auth application-default login`) em vez da
# Developer API com GEMINI_API_KEY -- util pra sair do rate limit do tier gratuito.
# Atencao: gemini-3.1-flash-lite so existe na regiao `global` do Vertex; nas regioes
# nomeadas (us-central1 etc.) a chamada volta 404 NOT_FOUND.
GCP_PROJECT=
GCP_LOCATION=global

# OpenAI (optional — install with: pip install ".[openai]")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local — install Ollama and pull the model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Qdrant (Docker — see README for setup)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Prints de debug ao longo das pipelines (extração, embedding, ingestão, matching, vectorstore)
DEBUG=false
